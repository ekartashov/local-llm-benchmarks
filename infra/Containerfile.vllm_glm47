# Custom vLLM image for GLM-4.7-Flash support
# Based on cu130-nightly as recommended for sm_120 + Glm4MoeLite support.

FROM docker.io/vllm/vllm-openai:cu130-nightly

# Install git for pip-git installs
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Update pip and install latest transformers from source for Glm4MoeLite recognition
RUN python3 -m pip install --no-cache-dir -U pip && \
    python3 -m pip install --no-cache-dir -U "git+https://github.com/huggingface/transformers.git"

# Patch placeholder: bug location confirmed in lines 1-394 of glm4_moe_tool_parser.py
# (helpers: _build_args_json_so_far, _extract_tool_call_regions, or extract_tool_calls).
# Do NOT apply PR #37385 sed — those variable names don't exist in cu130-nightly build.
# Correct patch to be added after R9 diagnostic completes. See RESEARCH_STATE.md R9.

LABEL org.opencontainers.image.description="vLLM with native GLM-4.7-Flash (Glm4MoeLite) support (patch pending R9 diagnosis)"
